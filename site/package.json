{
  "name": "izziwoot-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "test": "vitest run",
    "verify:headers": "node scripts/assert-headers.mjs",
    "verify:output": "node scripts/assert-no-governance-leak.mjs",
    "lint:content": "node scripts/check-filenames.mjs",
    "lint:md": "markdownlint-cli2",
    "lint:links": "lychee --config ../lychee.toml --root-dir \"$PWD/dist\" dist",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm check && pnpm lint:content && pnpm lint:md && pnpm format:check && pnpm test && pnpm build && pnpm verify:headers && pnpm verify:output && pnpm lint:links",
    "lint:lighthouse": "cd .. && pnpm dlx @lhci/cli@0.15.1 autorun --config=./site/lighthouserc.json",
    "assets:og": "node scripts/generate-og.mjs",
    "prepare": "git -C .. config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-reading-time": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@types/node": "^22",
    "fast-xml-parser": "^5.11.2",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6",
    "vitest": "^3.2.7"
  }
}
