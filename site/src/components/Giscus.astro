---
import { site } from '@/config/site';

/**
 * Comment threads are GitHub Discussions. No tracking, no database, no
 * moderation surface of our own — lock, delete, block and abuse reporting are
 * GitHub's, already built.
 *
 * This is one of exactly two third-party origins the site loads, and the reason
 * INV-4 is scoped to "no first-party framework JS" rather than "no JS at all"
 * (spec §10.3). It mounts on post pages only.
 */
---

<section class="comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading">Comments</h2>
  <p class="post-meta">
    Comments are GitHub Discussions and need a GitHub account. No account? The
    <a href="/about/">about page</a> has other ways to reach me.
  </p>
  <!--
    FR-35: "reserve its vertical space to avoid shift on load". giscus injects its
    own container only once client.js has loaded, so a rule written solely against
    giscus's classes has no element to match beforehand. This wrapper exists in the
    static HTML, so the reservation applies from first paint.

    The class is deliberately ours: giscus names its own injected iframe
    `giscus-frame`, and reusing that name made one selector match both our wrapper
    and their iframe.
  -->
  <div class="comments-reserve">
    <script
      src="https://giscus.app/client.js"
      data-repo={site.giscus.repo}
      data-repo-id={site.giscus.repoId}
      data-category={site.giscus.category}
      data-category-id={site.giscus.categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="0"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    />
  </div>
</section>
