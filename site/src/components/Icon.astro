---
type Props = { name: 'github' | 'linkedin' | 'x' | 'rss' | 'email'; label?: string };
const { name, label } = Astro.props;

/**
 * Inline SVG only. An icon font is a third-party request, a flash-of-invisible-
 * text risk, and a screen-reader hazard — and font-src 'self' would block it.
 * Paths are simple originals, drawn to read at 20px rather than to imitate any
 * particular icon set.
 */
const paths: Record<Props['name'], string> = {
  github:
    'M12 2.5a9.5 9.5 0 0 0-3 18.5c.4.08.6-.18.6-.42v-1.6c-2.4.5-3-1.1-3-1.1-.4-1-1-1.3-1-1.3-.8-.55.06-.54.06-.54.9.06 1.36.9 1.36.9.8 1.34 2.07.95 2.58.73.08-.57.31-.96.56-1.18-1.97-.22-4.04-.98-4.04-4.37 0-.97.35-1.76.92-2.38-.09-.22-.4-1.12.09-2.34 0 0 .74-.24 2.43.9a9 9 0 0 1 4.42 0c1.69-1.14 2.43-.9 2.43-.9.49 1.22.18 2.12.09 2.34.57.62.92 1.41.92 2.38 0 3.4-2.08 4.15-4.05 4.37.32.28.6.82.6 1.65v2.44c0 .24.2.5.6.42A9.5 9.5 0 0 0 12 2.5z',
  linkedin:
    'M4 8h3.5v12H4zM5.75 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM10 8h3.4v1.7A3.7 3.7 0 0 1 20 12.6V20h-3.5v-6.3a1.8 1.8 0 0 0-3.6 0V20H10z',
  x: 'M3.5 3.5h5.2l4.1 5.6 4.4-5.6h3.3l-6 7.7 6.4 8.8h-5.2l-4.2-5.8-4.6 5.8H3.6l6.3-8z',
  rss: 'M5 12a7 7 0 0 1 7 7H9.5A4.5 4.5 0 0 0 5 14.5zm0-5.5A12.5 12.5 0 0 1 17.5 19H15A10 10 0 0 0 5 9zM6.2 16.6a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8z',
  email: 'M3.5 6h17v12h-17zm1.7 1.7v.6L12 13l6.8-4.7v-.6z',
};
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="currentColor"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path d={paths[name]} />
</svg>
